# Copy to .env. Runtime environment > .env > legacy .env.local.
# If retaining legacy model configuration, put ONLY the account settings in .env.
# Generate separate random values: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
SITE_PASSWORD=
JWT_SECRET=
JWT_TTL_DAYS=30
LEARNER_NAME=备考同学
# Optional HTTPS site URL, e.g. https://study.example.com
PUBLIC_URL=
# Leave empty for direct access. The included frontend proxies one trusted hop.
TRUST_PROXY=
HOST=0.0.0.0
PORT=3210
# Local legacy JSON mode is retained for migration/compatibility only.
STORAGE_DRIVER=postgres
# Set at runtime; never put the database connection string in an image or VITE_*.
DATABASE_URL=
# For the local Compose database; use a generated hex password and the matching
# DATABASE_URL=postgresql://xingce:THE_SAME_HEX_PASSWORD@database:5432/xingce
POSTGRES_PASSWORD=
# PostgreSQL + Redis are required by the production stateless backend.
REDIS_URL=
REDIS_PASSWORD=
REDIS_PREFIX=xingce:
SERVE_FRONTEND=false
# Private S3 resources; app credentials must only have Read access.
RESOURCE_DRIVER=s3
S3_ENDPOINT=http://seaweedfs:8333
S3_BUCKET=xingce-resources
S3_REGION=us-east-1
S3_PREFIX=question-resources
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Local development and packaging paths; unused by the production S3 loader.
QUESTION_BANK_PATH=
QUESTION_IMAGES_PATH=
# Full version from resources/manifest.json; required for container deployments.
QUESTION_RESOURCE_VERSION=
# Legacy JSON location, only used with STORAGE_DRIVER=files.
RUNTIME_PATH=

# OpenAI-compatible Chat Completions endpoint. Never put secrets in VITE_* variables.
LLM_BASE_URL=https://your-gateway.example/v1
LLM_API_KEY=
LLM_MODEL=
# Set true only after checking image input with your actual gateway/model.
LLM_VISION=false
LLM_TIMEOUT_MS=180000
LLM_MAX_TOKENS=8192
# Optional, only for models that support this field. DeepSeek Flash supports low/high/max.
LLM_REASONING_EFFORT=
# Optional DeepSeek-compatible toggle: enabled/disabled; empty uses provider defaults.
LLM_THINKING=
# Reasoning models may spend tokens before the small final tool payload.
LLM_TOOL_MAX_TOKENS=2048
# Image reasoning needs more room than the short visible explanation alone.
LLM_IMAGE_MAX_TOKENS=32768
LLM_IMAGE_TOOL_MAX_TOKENS=8192
LLM_IMAGE_TIMEOUT_MS=300000
# Manual retries after output_limit increase that stage's budget up to this cap.
LLM_MAX_RETRY_TOKENS=65536
# Official TypeSafe Jev: POST {JEV_BASE_URL}/systemone
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=45000
# Optional visual transcription helper for Jev image questions.
# Uses LLM_* settings when these values are empty; requires VISION_ENABLED=true.
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
VISION_ENABLED=false
VISION_MAX_TOKENS=8192
VISION_REASONING_EFFORT=
VISION_THINKING=
