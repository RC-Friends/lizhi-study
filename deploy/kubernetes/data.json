{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "database-data",
        "namespace": "xingce"
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "resources": {
          "requests": {
            "storage": "10Gi"
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "redis-data",
        "namespace": "xingce"
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "resources": {
          "requests": {
            "storage": "1Gi"
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "seaweedfs-data",
        "namespace": "xingce"
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "resources": {
          "requests": {
            "storage": "10Gi"
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "database",
        "namespace": "xingce"
      },
      "spec": {
        "selector": {
          "app": "database"
        },
        "ports": [
          {
            "port": 5432,
            "targetPort": 5432
          }
        ],
        "type": "ClusterIP"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "database",
        "namespace": "xingce"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "database"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "database"
            }
          },
          "spec": {
            "terminationGracePeriodSeconds": 30,
            "containers": [
              {
                "name": "database",
                "image": "postgres:16-alpine",
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "memory": "1Gi"
                  }
                },
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "pg_isready",
                      "-U",
                      "xingce",
                      "-d",
                      "xingce"
                    ]
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 5
                },
                "env": [
                  {
                    "name": "POSTGRES_USER",
                    "value": "xingce"
                  },
                  {
                    "name": "POSTGRES_DB",
                    "value": "xingce"
                  }
                ],
                "envFrom": [
                  {
                    "secretRef": {
                      "name": "xingce-postgres"
                    }
                  }
                ],
                "ports": [
                  {
                    "containerPort": 5432
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/var/lib/postgresql/data"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "data",
                "persistentVolumeClaim": {
                  "claimName": "database-data"
                }
              }
            ]
          }
        },
        "strategy": {
          "type": "Recreate"
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "redis",
        "namespace": "xingce"
      },
      "spec": {
        "selector": {
          "app": "redis"
        },
        "ports": [
          {
            "port": 6379,
            "targetPort": 6379
          }
        ],
        "type": "ClusterIP"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "redis",
        "namespace": "xingce"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "redis"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "redis"
            }
          },
          "spec": {
            "terminationGracePeriodSeconds": 30,
            "containers": [
              {
                "name": "redis",
                "image": "redis:7.4-alpine",
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "memory": "1Gi"
                  }
                },
                "command": [
                  "sh",
                  "-c",
                  "exec redis-server --appendonly yes --maxmemory 256mb --maxmemory-policy noeviction --requirepass \"$REDIS_PASSWORD\""
                ],
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "sh",
                      "-c",
                      "REDISCLI_AUTH=\"$REDIS_PASSWORD\" redis-cli ping | grep -q PONG"
                    ]
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 5
                },
                "envFrom": [
                  {
                    "secretRef": {
                      "name": "xingce-redis"
                    }
                  }
                ],
                "ports": [
                  {
                    "containerPort": 6379
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/data"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "data",
                "persistentVolumeClaim": {
                  "claimName": "redis-data"
                }
              }
            ]
          }
        },
        "strategy": {
          "type": "Recreate"
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "seaweedfs",
        "namespace": "xingce"
      },
      "spec": {
        "selector": {
          "app": "seaweedfs"
        },
        "ports": [
          {
            "port": 8333,
            "targetPort": 8333
          }
        ],
        "type": "ClusterIP",
        "clusterIP": "None",
        "publishNotReadyAddresses": true
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "seaweedfs",
        "namespace": "xingce"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "seaweedfs"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "seaweedfs"
            }
          },
          "spec": {
            "terminationGracePeriodSeconds": 30,
            "containers": [
              {
                "name": "seaweedfs",
                "image": "chrislusf/seaweedfs@sha256:e1ee85a3089d96c4f3df699a0944468557813f5df306819c9d368c4039070ddf",
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "memory": "1Gi"
                  }
                },
                "args": [
                  "mini",
                  "-dir=/data",
                  "-ip=seaweedfs",
                  "-ip.bind=0.0.0.0",
                  "-s3.config=/etc/seaweedfs/s3.json",
                  "-webdav=false",
                  "-admin.ui=false",
                  "-s3.port.iceberg=0"
                ],
                "readinessProbe": {
                  "httpGet": {
                    "port": 9333,
                    "path": "/cluster/status"
                  },
                  "periodSeconds": 10,
                  "timeoutSeconds": 5
                },
                "env": [
                  {
                    "name": "S3_BUCKET",
                    "value": "xingce-resources"
                  }
                ],
                "ports": [
                  {
                    "containerPort": 8333
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/data"
                  },
                  {
                    "name": "s3-config",
                    "mountPath": "/etc/seaweedfs",
                    "readOnly": true
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "data",
                "persistentVolumeClaim": {
                  "claimName": "seaweedfs-data"
                }
              },
              {
                "name": "s3-config",
                "secret": {
                  "secretName": "xingce-s3"
                }
              }
            ]
          }
        },
        "strategy": {
          "type": "Recreate"
        }
      }
    }
  ]
}
