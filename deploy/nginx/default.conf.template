# Resolve all replicas again after DNS changes; no sticky sessions are needed.
upstream api_backend {
    zone api_backend 64k;
    resolver ${DNS_RESOLVER} valid=5s ipv6=off;
    server ${BACKEND_HOST}:${BACKEND_PORT} resolve;
    keepalive 32;
}
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 24k;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header X-Frame-Options DENY always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" always;
    location = /frontend-health { access_log off; return 200 'ok'; }
    location /api/ {
        proxy_pass http://api_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        # A failed POST must never be replayed on another backend.
        proxy_next_upstream error timeout;
    }
    location /api/admin/question-bank/ {
        client_max_body_size 128m;
        proxy_pass http://api_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_next_upstream off;
    }
    location /assets/images/ {
        proxy_pass http://api_backend;
        proxy_set_header Host $http_host;
    }
    location /skills/ {
        try_files $uri =404;
        types { text/plain md yaml; }
        default_type text/plain;
        charset utf-8;
        expires -1;
    }
    location /assets/ { try_files $uri =404; expires 1y; }
    location / { try_files $uri $uri/ /index.html; expires -1; }
    location ~ /\. { deny all; }
}
